@using LiaAgro.Institucional.Services
@{
    var lang = I18n.Normalize(ViewContext.RouteData.Values["lang"]?.ToString());
    Func<string, string> t = key => I18n.Text(lang, key);
    var slug = (ViewData["PageSlug"]?.ToString()) ?? "";
    var fullTitle = (ViewData["Title"]?.ToString() ?? "LIA AGRO") + " | LIA AGRO";
    var desc = ViewData["Description"]?.ToString() ?? t("meta.desc");
    var contact = "https://wa.me/5561996476034?text=Ol%C3%A1%21%20Gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20a%20LIA%20AGRO.";
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#123e2f" />
    <meta name="description" content="@desc" />
    <title>@fullTitle</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#conteudo">@t("a11y.skip")</a>
    <header class="site-header" id="topo">
        <div class="shell header-inner">
            <a class="brand" href="/@lang" aria-label="LIA AGRO - @t("nav.home")">
                <img class="brand-logo" src="~/images/lia-logo-topo.png" alt="" width="72" height="72" /><span class="brand-copy"><strong>LIA AGRO</strong><small>@t("brand.tag")</small></span>
            </a>
            <button type="button" class="menu-toggle" aria-label="@t("nav.open")" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span></button>
            <nav id="main-nav" class="main-nav" aria-label="@t("nav.menu")">
                <a href="/@lang" class="@(slug == "" ? "active" : "")">@t("nav.home")</a>
                <a href="/@lang/empresa" class="@(slug == "empresa" ? "active" : "")">@t("nav.about")</a>
                <div class="nav-dropdown">
                    <a href="/@lang#produtos" class="@(slug == "rocksil" || slug == "protego-fl" ? "active" : "")">@t("nav.products") <span aria-hidden="true">⌄</span></a>
                    <div class="dropdown-menu">
                        <a href="/@lang/rocksil">ROCKSIL PLUS</a>
                        <a href="/@lang/protego-fl">PROTEGO FL</a>
                    </div>
                </div>
                <a href="/@lang/contato" class="@(slug == "contato" ? "active" : "")">@t("nav.contact")</a>
            </nav>
            <div class="header-actions">
                <label class="language-control"><span class="sr-only">@t("nav.language")</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c-4 5-4 13 0 18M12 3c4 5 4 13 0 18"/></svg><select id="lang-switch" data-slug="@slug" aria-label="@t("nav.language")">
                    <option value="pt" selected="@(lang=="pt")">PT</option><option value="en" selected="@(lang=="en")">EN</option><option value="it" selected="@(lang=="it")">IT</option><option value="es" selected="@(lang=="es")">ES</option><option value="de" selected="@(lang=="de")">DE</option><option value="fr" selected="@(lang=="fr")">FR</option>
                </select></label>
                <a class="button button-dark button-small desktop-contact" href="@contact" target="_blank" rel="noopener noreferrer"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 11.5a8.2 8.2 0 0 1-11.7 7.4L4 20l1.2-4.1A8.1 8.1 0 1 1 20 11.5Z"/></svg>@t("cta.talk")</a>
            </div>
        </div>
    </header>
    <main id="conteudo">@RenderBody()</main>
    <footer class="site-footer">
        <div class="shell footer-grid">
            <div class="footer-brand"><div><strong>LIA AGRO</strong><p>@t("footer.blurb")</p></div></div>
            <div><h3>@t("nav.products")</h3><a href="/@lang/rocksil">ROCKSIL PLUS</a><a href="/@lang/protego-fl">PROTEGO FL</a></div>
            <div><h3>@t("footer.company")</h3><a href="/@lang/empresa">@t("nav.about")</a><a href="/@lang/contato">@t("nav.contact")</a></div>
            <div><h3>@t("nav.contact")</h3><a href="mailto:lia@liaagro.com.br">lia@liaagro.com.br</a><a href="tel:+556134781173">+55 (61) 3478-1173</a><a href="https://wa.me/5561996476034" target="_blank" rel="noopener noreferrer">+55 (61) 99647-6034</a><a href="https://wa.me/5561999815822" target="_blank" rel="noopener noreferrer">+55 (61) 99981-5822</a></div>
        </div>
        <div class="shell footer-bottom"><span>© @DateTime.UtcNow.Year LIA AGRO · @t("footer.rights")</span><span>Brasília · DF · Brasil</span></div>
    </footer>
    <a class="whatsapp-float" href="@contact" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp LIA AGRO"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.3 11.2a8.4 8.4 0 0 1-12 7.6L4 20l1.3-4.2A8.3 8.3 0 1 1 20.3 11.2Z"/><path d="M9 8.3c-.5-.2-1.4.8-1.2 1.9.4 2.4 3.5 5.3 5.8 5.5 1.3.1 2.5-.9 2.1-1.4l-1.6-.8-.8.8c-1.5-.4-2.5-1.5-3.2-2.9l.8-.9-.9-2.2Z"/></svg></a>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
