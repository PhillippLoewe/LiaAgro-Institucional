@page "/{lang}/protego-fl"
@model ProtegoModel
@{
    var lang = Model.Lang;
    Func<string,string> t = k => I18n.Text(lang,k);
    ViewData["Title"] = "PROTEGO FL";
    ViewData["PageSlug"] = "protego-fl";
    ViewData["Description"] = t("protego.short");
}
<section class="product-page-hero protego-hero"><div class="shell product-hero-grid"><div class="product-hero-copy"><span class="eyebrow eyebrow-light">LIA AGRO · @t("products.food")</span><h1>PROTEGO <span>FL®</span></h1><h2>@t("protego.hero")</h2><p>@t("protego.lead")</p><a class="button button-primary" href="#detalhes">@t("cta.discover") ↓</a></div><div class="protego-cover-holder"><img src="~/images/protego-capa.webp" alt="@t("alt.protegocover")" /></div></div></section>
<section class="section" id="detalhes"><div class="shell split-section"><div><span class="eyebrow">@t("protego.what.kicker")</span><h2>@t("protego.what.title")</h2><p>@t("protego.what.body")</p><p>@t("protego.what.body2")</p></div><div class="photo-panel"><img src="~/images/protego-frutas.webp" alt="@t("alt.fruits")" loading="lazy" /></div></div></section>
<section class="section soft-bg"><div class="shell"><div class="section-intro"><span class="eyebrow">@t("protego.benefits.kicker")</span><h2>@t("protego.benefits.title")</h2></div><div class="info-columns"><article><span class="card-number">01</span><h3>@t("protego.benefit1.title")</h3><p>@t("protego.benefit1.body")</p></article><article><span class="card-number">02</span><h3>@t("protego.benefit2.title")</h3><p>@t("protego.benefit2.body")</p></article><article><span class="card-number">03</span><h3>@t("protego.benefit3.title")</h3><p>@t("protego.benefit3.body")</p></article></div></div></section>
<section class="section"><div class="shell"><div class="section-intro"><span class="eyebrow">@t("protego.app.kicker")</span><h2>@t("protego.app.title")</h2></div><div class="steps-grid"><div class="step"><span>01</span><h3>@t("protego.app1.title")</h3><p>@t("protego.app1.body")</p></div><div class="step"><span>02</span><h3>@t("protego.app2.title")</h3><p>@t("protego.app2.body")</p></div><div class="step"><span>03</span><h3>@t("protego.app3.title")</h3><p>@t("protego.app3.body")</p></div></div><div class="wide-photo"><img src="~/images/protego-lavagem-macas.webp" alt="@t("alt.apples")" loading="lazy" /><div><strong>@t("protego.image.title")</strong><p>@t("protego.image.body")</p></div></div></div></section>
<section class="section soft-bg"><div class="shell tech-layout"><div><span class="eyebrow">@t("tech.kicker")</span><h2>@t("tech.headline")</h2><div class="tech-table"><div><strong>@t("tech.form")</strong><span>@t("protego.tech.form")</span></div><div><strong>@t("tech.composition")</strong><span>@t("protego.tech.comp")</span></div><div><strong>@t("tech.concentration")</strong><span>0,75%</span></div><div><strong>@t("tech.contacttime")</strong><span>@t("protego.tech.time")</span></div><div><strong>@t("tech.package")</strong><span>2 kg</span></div><div><strong>@t("tech.storage")</strong><span>@t("protego.tech.storage")</span></div></div><p class="legal-note">@t("protego.tech.note")</p></div><div class="study-box"><span class="eyebrow">@t("protego.study.kicker")</span><h3>@t("protego.study.title")</h3><p>@t("protego.study.body")</p><div class="study-result"><strong>99,99%</strong><span>Salmonella spp.</span></div><div class="study-result"><strong>97,29%</strong><span>Escherichia coli</span></div><p class="legal-note">@t("protego.study.caution")</p></div></div></section>
<section class="cta-strip"><div class="shell cta-inner"><div><span class="eyebrow eyebrow-light">PROTEGO FL</span><h2>@t("protego.cta")</h2></div><a class="button button-light" href="/@lang/contato">@t("cta.talk") ↗</a></div></section>
