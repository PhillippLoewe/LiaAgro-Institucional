@page "/{lang}/empresa"
@model AboutModel
@{
    var lang = Model.Lang;
    Func<string,string> t = k => I18n.Text(lang,k);
    ViewData["Title"] = t("about.page.title");
    ViewData["PageSlug"] = "empresa";
    ViewData["Description"] = t("about.page.lead");
}
<section class="page-top page-top-about">
  <div class="shell about-hero-layout">
    <div class="about-hero-copy">
      <span class="eyebrow eyebrow-light">LIA AGRO · @t("about.kicker")</span>
      <h1>@t("about.page.title")</h1>
      <p>@t("about.page.lead")</p>
    </div>
    <figure class="about-world-map" aria-label="@t("about.map.alt")">
      <img src="@($"/images/mapa-presenca-internacional-{lang}.svg")" width="900" height="410" alt="" aria-hidden="true" decoding="async" />
      <figcaption class="about-map-caption">
        <span class="about-map-caption-title">@t("about.map.caption")</span>
      </figcaption>
    </figure>
  </div>
</section>
<section class="section story-section"><div class="shell story-layout"><div><span class="eyebrow">@t("about.kicker")</span><h2>@t("about.headline")</h2><p>@t("about.paragraph1")</p><p>@t("about.paragraph2")</p><p>@t("about.paragraph3")</p></div><aside class="story-callout"><span class="story-big">35+</span><h3>@t("about.years")</h3><p>@t("about.export")</p></aside></div></section>
<section class="section membership-section" aria-label="@t("ifoam.badge")">
  <div class="shell">
    <figure class="membership-compact">
      <img src="~/images/ifoam-organics-international.webp" alt="IFOAM – Organics International" width="145" height="124" loading="lazy" />
      <figcaption>@t("ifoam.badge")</figcaption>
    </figure>
  </div>
</section>
<section class="section soft-bg founder-section" aria-labelledby="founder-heading">
  <div class="shell">
    <div class="section-intro">
      <span class="eyebrow">@t("about.values.kicker")</span>
      <h2 id="founder-heading">@t("about.values.title")</h2>
    </div>
    <article class="founder-story">
      <p>@t("about.founder.p1")</p>
      <p class="founder-intro">@t("about.founder.intro")</p>
      <blockquote class="founder-quote">“@t("about.founder.quote")”</blockquote>
      <p>@t("about.founder.p2")</p>
      <p>@t("about.founder.p3")</p>
      <p>@t("about.founder.p4")</p>
      <p>@t("about.founder.p5")</p>
      <p>@t("about.founder.p6")</p>
      <p>@t("about.founder.p7")</p>
      <p>@t("about.founder.p8")</p>
      <p>@t("about.founder.p9")</p>
      <p>@t("about.founder.p10")</p>
      <p class="founder-closing">@t("about.founder.closing")</p>
    </article>
  </div>
</section>
<section class="cta-strip"><div class="shell cta-inner"><div><span class="eyebrow eyebrow-light">@t("products.kicker")</span><h2>@t("about.products.cta")</h2></div><a class="button button-light" href="/@lang#produtos">@t("cta.products") →</a></div></section>
