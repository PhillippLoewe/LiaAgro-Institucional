@page "/{lang}/rocksil"
@model RocksilModel
@{
    var lang = Model.Lang;
    Func<string,string> t = k => I18n.Text(lang,k);
    ViewData["Title"] = "ROCKSIL PLUS";
    ViewData["PageSlug"] = "rocksil";
    ViewData["Description"] = t("rocksil.short");
}
<section class="product-page-hero rocksil-hero"><div class="shell product-hero-grid"><div class="product-hero-copy"><span class="eyebrow eyebrow-light">LIA AGRO · @t("products.agri")</span><h1>ROCKSIL <span>PLUS®</span></h1><h2>@t("rocksil.hero")</h2><p>@t("rocksil.lead")</p><a class="button button-primary" href="#detalhes">@t("cta.discover") ↓</a></div><div class="product-hero-photo"><img src="~/images/rocksil-cafe.webp" alt="@t("alt.coffee")" /></div></div></section>
<section class="section" id="detalhes"><div class="shell split-section"><div><span class="eyebrow">@t("rocksil.what.kicker")</span><h2>@t("rocksil.what.title")</h2><p>@t("rocksil.what.body")</p><p>@t("rocksil.what.body2")</p></div><div class="mineral-note"><span class="mini-asterisk">✳</span><h3>@t("rocksil.note.title")</h3><p>@t("rocksil.note.body")</p><div class="mineral-chips"><span>Ca</span><span>Mg</span><span>S</span></div></div></div></section>
<section class="section soft-bg"><div class="shell"><div class="section-intro"><span class="eyebrow">@t("rocksil.benefits.kicker")</span><h2>@t("rocksil.benefits.title")</h2></div><div class="info-columns four"><article><span class="card-number">01</span><h3>@t("rocksil.benefit1.title")</h3><p>@t("rocksil.benefit1.body")</p></article><article><span class="card-number">02</span><h3>@t("rocksil.benefit2.title")</h3><p>@t("rocksil.benefit2.body")</p></article><article><span class="card-number">03</span><h3>@t("rocksil.benefit3.title")</h3><p>@t("rocksil.benefit3.body")</p></article><article><span class="card-number">04</span><h3>@t("rocksil.benefit4.title")</h3><p>@t("rocksil.benefit4.body")</p></article></div></div></section>
<section class="section" id="campo"><div class="shell"><div class="section-intro two-col-intro"><div><span class="eyebrow">@t("field.kicker")</span><h2>@t("field.headline")</h2></div><p>@t("field.lead")</p></div><div class="gallery-grid"><figure><a href="/images/rocksil-dia-campo.webp" target="_blank" rel="noopener noreferrer"><img src="~/images/rocksil-dia-campo.webp" alt="@t("alt.fieldday")" loading="lazy" /></a><figcaption><strong>@t("field.cooxupe")</strong><span>@t("field.cooxupe.sub")</span></figcaption></figure><figure><a href="/images/rocksil-cafe.webp" target="_blank" rel="noopener noreferrer"><img src="~/images/rocksil-cafe.webp" alt="@t("alt.coffee")" loading="lazy" /></a><figcaption><strong>@t("field.coffee")</strong><span>@t("field.coffee.sub")</span></figcaption></figure><figure><a href="/images/rocksil-morango.webp" target="_blank" rel="noopener noreferrer"><img src="~/images/rocksil-morango.webp" alt="@t("alt.strawberry")" loading="lazy" /></a><figcaption><strong>@t("field.strawberry")</strong><span>@t("field.strawberry.sub")</span></figcaption></figure><figure><a href="/images/rocksil-paprika.webp" target="_blank" rel="noopener noreferrer"><img src="~/images/rocksil-paprika.webp" alt="@t("alt.paprika")" loading="lazy" /></a><figcaption><strong>@t("field.paprika")</strong><span>@t("field.paprika.sub")</span></figcaption></figure></div></div></section>
<section class="section soft-bg"><div class="shell tech-layout"><div><span class="eyebrow">@t("tech.kicker")</span><h2>@t("tech.headline")</h2><p>@t("rocksil.tech.body")</p><div class="tech-table"><div><strong>@t("tech.classification")</strong><span>@t("rocksil.tech.class")</span></div><div><strong>@t("tech.composition")</strong><span>@t("rocksil.tech.composition")</span></div><div><strong>@t("tech.package")</strong><span>5 kg</span></div><div><strong>@t("tech.validity")</strong><span>@t("rocksil.tech.validity")</span></div></div><p class="legal-note">@t("rocksil.tech.note")</p></div><div class="technical-image"><img src="~/images/rocksil-embalagem.webp" alt="@t("alt.rocksilpackage")" loading="lazy" /></div></div></section>
<section class="cta-strip"><div class="shell cta-inner"><div><span class="eyebrow eyebrow-light">ROCKSIL PLUS</span><h2>@t("rocksil.cta")</h2></div><a class="button button-light" href="/@lang/contato">@t("cta.talk") ↗</a></div></section>
